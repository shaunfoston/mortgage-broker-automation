# ── Mortgage Options backend configuration ──────────────────────────────
# Copy to .env and fill in. Never commit .env. Never put these keys in the app.

# demo = no external AI calls; fictional transcript + extraction (safe for first tests)
# live = real AssemblyAI transcription + Claude extraction (needs both keys below)
AI_MODE=demo

PORT=3005
HOST=0.0.0.0

# Long random strings (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required in live mode. In demo mode a temporary one is generated if blank.
JWT_SECRET=
# Encrypts transcripts held temporarily on the server (AES-256-GCM).
DATA_KEY=

# Speech-to-text — https://www.assemblyai.com (EU endpoint keeps audio in the EU)
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com
ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2

# Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional
DATA_DIR=./data
MAX_AUDIO_MB=200
TOKEN_TTL_HOURS=12
# Set to 1 when running behind a reverse proxy / tunnel that sets X-Forwarded-For
TRUST_PROXY=0
